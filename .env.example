# ════════════════════════════════════════════════════════════════
#  Finance OS — env vars
#  Copy this file to .env.local for local dev, or set in Vercel
#  → Settings → Environment Variables for production.
# ════════════════════════════════════════════════════════════════

# ─── AI Advisor (Claude) ──────────────────────────────────────────
# Powers the Analysis card and Advisor tab.
# Get a key at https://console.anthropic.com/settings/keys
# Optional: without this, advisor returns a setup hint instead.
ANTHROPIC_API_KEY=

# ─── OpenCLAW / n8n webhook auth ──────────────────────────────────
# Shared secret your automation passes when POSTing to /api/log-expense.
# Optional: if unset, /api/log-expense is open (fine for private use).
LOG_SECRET=

# ─── Email reports (Resend) ───────────────────────────────────────
# Get a free key at https://resend.com (3000 emails/month free).
# Used by /api/send-report — daily 8:30am + weekly Mon 7:30am IST via Vercel Cron.
RESEND_API_KEY=
REPORT_EMAIL=

# ─── Persistent storage (Vercel KV / Upstash) ─────────────────────
# REQUIRED if you want historical data (6-month analysis etc.) — without
# these, state lives in memory and resets on every restart/redeploy.
#
# Sign up free at https://upstash.com (or via Vercel → Storage tab), create
# a Redis database, then copy these two values from the dashboard:
KV_REST_API_URL=
KV_REST_API_TOKEN=
